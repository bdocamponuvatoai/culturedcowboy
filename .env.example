# Copy to .env.local for local overrides. Both values are read at build time.

# Public origin used for canonical URLs, Open Graph and the sitemap (no trailing slash).
# Falls back to https://$VERCEL_PROJECT_PRODUCTION_URL on Vercel, then http://localhost:3000.
SITE_URL=https://www.example.com

# Let search engines index the site. Leave false until the owner approves launch.
# true requires a real SITE_URL (the build fails if the URL is still localhost).
SITE_INDEXABLE=false
